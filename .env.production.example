# Pacific Impact Database - PRODUCTION Environment Configuration
# ⚠️  CRITICAL: Never commit actual production secrets to version control!
# This file contains placeholder values. Generate strong secrets before deployment.

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================

POSTGRES_DB=impact_db
POSTGRES_USER=postgres

# 🔐 REQUIRED: Generate a strong password (minimum 32 characters)
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD_32_CHARS_MIN

DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@postgis_db:5432/impact_db

# ==============================================================================
# REDIS CONFIGURATION
# ==============================================================================

REDIS_URL=redis://redis:6379/0

# 🔐 OPTIONAL: Enable Redis password for production
# REDIS_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
# REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# ==============================================================================
# MINIO / S3 STORAGE CONFIGURATION
# ==============================================================================

MINIO_ENDPOINT=minio:9000

# 🔐 REQUIRED: Change default MinIO credentials
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
MINIO_ROOT_USER=REPLACE_WITH_ADMIN_USERNAME
MINIO_ROOT_PASSWORD=REPLACE_WITH_STRONG_PASSWORD_32_CHARS_MIN

MINIO_ACCESS_KEY=${MINIO_ROOT_USER}
MINIO_SECRET_KEY=${MINIO_ROOT_PASSWORD}
MINIO_SECURE=true
MINIO_USE_SSL=true
MINIO_BUCKET_NAME=impact-images

# ==============================================================================
# APPLICATION SECURITY
# ==============================================================================

ENVIRONMENT=production
DEBUG=false

# 🔐 REQUIRED: Generate a strong secret key (minimum 64 characters)
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=REPLACE_WITH_STRONG_SECRET_KEY_64_CHARS_MIN

# JWT Configuration
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==============================================================================
# API CONFIGURATION
# ==============================================================================

API_V1_STR=/api/v1
PROJECT_NAME=Pacific Impact Database
VERSION=1.0.0

# 🔐 REQUIRED: Set your production API base URL (used by Celery workers for webhooks)
API_BASE_URL=https://api.yourdomain.com

# 🔐 REQUIRED: Set your production domain
# Format: ["https://yourdomain.com","https://www.yourdomain.com"]
BACKEND_CORS_ORIGINS=["https://yourdomain.com"]

# ==============================================================================
# FILE UPLOAD CONFIGURATION
# ==============================================================================

MAX_FILE_SIZE=52428800
ALLOWED_FILE_EXTENSIONS=.jpg,.jpeg,.png,.tiff,.tif,.gif

# Thumbnail Configuration
THUMBNAIL_SIZE=[200,200]
THUMBNAIL_QUALITY=85

# ==============================================================================
# PYTHON CONFIGURATION
# ==============================================================================

PYTHONPATH=/app
PYTHONUNBUFFERED=1

# ==============================================================================
# PUSH NOTIFICATIONS (Web Push / VAPID)
# ==============================================================================

# 🔐 REQUIRED: Generate VAPID keys for push notifications
# Generate: python3 -c 'from pywebpush import webpush; vapid = webpush.vapid_key(); print(f"Public: {vapid.public_key.decode()}\nPrivate: {vapid.private_key.decode()}")'

# IMPORTANT:
# - Public key goes in frontend .env.local as NEXT_PUBLIC_VAPID_PUBLIC_KEY
# - Private key stays here (server-side only, never expose to client)

VAPID_PRIVATE_KEY=REPLACE_WITH_GENERATED_VAPID_PRIVATE_KEY
VAPID_SUBJECT=mailto:admin@yourdomain.com

# ==============================================================================
# SSO / OAUTH CONFIGURATION (Optional)
# ==============================================================================

# SPC SSO (OpenID Connect)
NEXT_PUBLIC_SPC_SSO_ISSUER=https://sso.spc.int
NEXT_PUBLIC_SPC_SSO_CLIENT_ID=REPLACE_WITH_YOUR_CLIENT_ID

# Google OAuth (Optional)
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET

# GitHub OAuth (Optional)
# NEXT_PUBLIC_GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=REPLACE_WITH_GITHUB_CLIENT_SECRET

# Facebook OAuth (Optional)
# NEXT_PUBLIC_FACEBOOK_APP_ID=your-facebook-app-id
# FACEBOOK_APP_SECRET=REPLACE_WITH_FACEBOOK_APP_SECRET

# ==============================================================================
# MONITORING & LOGGING (Optional but Recommended)
# ==============================================================================

# Sentry Error Tracking (if used)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# SENTRY_ENVIRONMENT=production

# Log Level
LOG_LEVEL=INFO

# ==============================================================================
# BACKUP CONFIGURATION
# ==============================================================================

# S3-compatible backup storage (recommended for production)
# BACKUP_S3_BUCKET=your-backup-bucket
# BACKUP_S3_REGION=us-east-1
# BACKUP_S3_ACCESS_KEY=REPLACE_WITH_BACKUP_ACCESS_KEY
# BACKUP_S3_SECRET_KEY=REPLACE_WITH_BACKUP_SECRET_KEY

# Backup retention (days)
BACKUP_RETENTION_DAYS=30

# ==============================================================================
# SSL/TLS CONFIGURATION
# ==============================================================================

# Set to true when using HTTPS reverse proxy
USE_SSL=true
SECURE_COOKIES=true

# ==============================================================================
# RATE LIMITING
# ==============================================================================

RATE_LIMIT_PER_MINUTE=60
UPLOAD_RATE_LIMIT_PER_HOUR=50

# ==============================================================================
# SECRETS GENERATION GUIDE
# ==============================================================================

# Run these commands to generate all required secrets:

# 1. Generate SECRET_KEY (64 chars):
#    python3 -c "import secrets; print(secrets.token_urlsafe(64))"

# 2. Generate Database Password (32 chars):
#    python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# 3. Generate MinIO Credentials (24-32 chars):
#    python3 -c "import secrets; print(f'User: {secrets.token_urlsafe(16)}\nPass: {secrets.token_urlsafe(32)}')"

# 4. Generate VAPID Keys (for push notifications):
#    python3 -c 'from pywebpush import webpush; vapid = webpush.vapid_key(); print(f"Public: {vapid.public_key.decode()}\nPrivate: {vapid.private_key.decode()}")'

# 5. Generate API Keys (if needed):
#    python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# ==============================================================================
# DEPLOYMENT CHECKLIST
# ==============================================================================

# Before deploying to production:
# ✅ Replace ALL placeholder values with generated secrets
# ✅ Set ENVIRONMENT=production and DEBUG=false
# ✅ Configure BACKEND_CORS_ORIGINS with your domain(s)
# ✅ Generate and set VAPID keys for push notifications
# ✅ Configure SSL/TLS certificates (see HTTPS_SSL_SETUP.md)
# ✅ Set up automated database backups (see DATABASE_BACKUP.md)
# ✅ Review and set appropriate rate limits
# ✅ Configure monitoring (Sentry, logs, metrics)
# ✅ Store this file securely (NOT in version control)
# ✅ Use environment-specific secrets management (AWS Secrets Manager, Vault, etc.)

# ==============================================================================
# SECURITY WARNINGS
# ==============================================================================

# 🚨 NEVER commit this file with real secrets to version control
# 🚨 Use strong, randomly generated passwords (never dictionary words)
# 🚨 Rotate secrets regularly (every 90 days recommended)
# 🚨 Use different credentials for each environment (dev/staging/prod)
# 🚨 Limit access to production secrets to essential personnel only
# 🚨 Enable audit logging for secret access
# 🚨 Use secrets management tools (AWS Secrets Manager, HashiCorp Vault, etc.)
