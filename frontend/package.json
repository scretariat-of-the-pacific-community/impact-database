{
  "name": "pacific-impact-atlas-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:clean": "rm -rf .next && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "dev:host": "next dev -H 0.0.0.0",
    "test": "jest",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lighthouse": "lhci autorun --config=lighthouserc.json",
    "lighthouse:ci": "lhci autorun --config=lighthouserc.json",
    "lighthouse:local": "echo 'Note: Lighthouse requires Chrome with display in WSL2. Consider running from Windows or CI/CD.' && npx lighthouse@11 http://localhost:3100 --chrome-flags=\"--headless --no-sandbox --disable-gpu\" --output html --output-path=./lighthouse-report.html",
    "audit:pa11y": "pa11y-ci",
    "audit:axe": "jest --testPathPattern=axe",
    "audit:a11y": "npm run audit:pa11y && npm run audit:axe",
    "audit:all": "bash scripts/audit.sh",
    "analyze": "ANALYZE=true npm run build",
    "prepare": "cd .. && husky frontend/.husky"
  },
  "dependencies": {
    "@headlessui/react": "^2.0.0",
    "@radix-ui/react-popover": "^1.1.15",
    "@tanstack/react-query": "^5.17.0",
    "@tanstack/react-virtual": "^3.13.18",
    "axios": "^1.6.0",
    "clsx": "^2.0.0",
    "cmdk": "^1.1.1",
    "date-fns": "^3.0.0",
    "driver.js": "^1.4.0",
    "es-toolkit": "^1.43.0",
    "exif-js": "^2.3.0",
    "framer-motion": "^11.0.0",
    "html2canvas": "^1.4.1",
    "idb": "^8.0.3",
    "isomorphic-dompurify": "^2.31.0",
    "js-cookie": "^3.0.5",
    "jspdf": "^3.0.4",
    "leaflet": "^1.9.4",
    "leaflet-draw": "^1.0.4",
    "lucide-react": "^0.562.0",
    "mapbox-gl": "^3.17.0",
    "next": "^16.0.10",
    "next-pwa": "^5.6.0",
    "react": "19.1.0",
    "react-compare-slider": "^3.1.0",
    "react-datepicker": "^4.25.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.48.0",
    "react-intersection-observer": "^9.5.3",
    "react-leaflet": "^5.0.0",
    "react-select": "^5.8.0",
    "react-virtualized-auto-sizer": "^1.0.26",
    "react-window": "^1.8.11",
    "recharts": "^3.5.1",
    "regression": "^2.0.1",
    "sonner": "^2.0.7",
    "workbox-webpack-plugin": "^7.3.0"
  },
  "devDependencies": {
    "@axe-core/react": "^4.11.0",
    "@eslint/eslintrc": "^3",
    "@lhci/cli": "^0.15.1",
    "@next/bundle-analyzer": "^16.0.1",
    "@playwright/test": "^1.50.1",
    "@storybook/addon-essentials": "^8.4.0",
    "@storybook/addon-interactions": "^8.4.0",
    "@storybook/addon-links": "^8.4.0",
    "@storybook/blocks": "^8.4.0",
    "@storybook/nextjs": "^8.4.0",
    "@storybook/react": "^8.4.0",
    "@storybook/test": "^8.4.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/dom": "^10.1.0",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^16.0.0",
    "@types/jest": "^29.5.12",
    "@types/js-cookie": "^3.0.6",
    "@types/leaflet": "^1.9.20",
    "@types/leaflet-draw": "^1.0.8",
    "@types/minimatch": "^6.0.0",
    "@types/node": "^20.19.10",
    "@types/react": "^19",
    "@types/react-datepicker": "^4.19.0",
    "@types/react-dom": "^19",
    "@types/react-window": "^1.8.8",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "axe-core": "^4.11.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.22",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-react-hooks": "^4.3.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lighthouse": "^12.8.2",
    "lint-staged": "^15.2.11",
    "pa11y": "^9.0.1",
    "pa11y-ci": "^4.0.1",
    "prettier": "^3.0.0",
    "storybook": "^8.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "web-vitals": "^5.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
