# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
POSTGRES_DB=impact_db
POSTGRES_USER=postgres
# Using existing database password to maintain data continuity
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@postgis_db:5432/impact_db

# ==============================================================================
# REDIS CONFIGURATION
# ==============================================================================
REDIS_URL=redis://redis:6379/0
# Redis password (empty for non-auth Redis, set for production security)
REDIS_PASSWORD=

# ==============================================================================
# MINIO / S3 STORAGE CONFIGURATION
# ==============================================================================
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=impactadmin
MINIO_ROOT_PASSWORD=xEkEYSYXSOJDon-TkSJqgKxI2a37VY-OnSsV3PZNJQY
MINIO_ACCESS_KEY=impactadmin
MINIO_SECRET_KEY=xEkEYSYXSOJDon-TkSJqgKxI2a37VY-OnSsV3PZNJQY
MINIO_SECURE=false
MINIO_USE_SSL=false
MINIO_BUCKET_NAME=impact-images

# ==============================================================================
# APPLICATION SECURITY
# ==============================================================================
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=iSOmIPi2GpYO9Bxhg38XA-Wa37YpOLcEvxw9qU7JpO30dqASt-iFGCpKYlvSf_tbN8GYDaQgtyYC-RnmGbIFVA

# JWT Configuration
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW=900

# Session Security
SESSION_SECURE=true
SESSION_SAMESITE=strict
SESSION_HTTPONLY=true

# ==============================================================================
# API CONFIGURATION
# ==============================================================================
API_V1_STR=/api/v1
PROJECT_NAME="Pacific Impact Database"
VERSION=1.0.0

# CORS Configuration - Update with your production domain
BACKEND_CORS_ORIGINS='["https://localhost:3000","https://localhost:8000"]'

# ==============================================================================
# FILE UPLOAD CONFIGURATION
# ==============================================================================
MAX_FILE_SIZE=52428800
ALLOWED_FILE_EXTENSIONS=.jpg,.jpeg,.png,.tiff,.tif,.gif
THUMBNAIL_SIZE=[200,200]
THUMBNAIL_QUALITY=85

# ==============================================================================
# PYTHON CONFIGURATION
# ==============================================================================
PYTHONPATH=/app
PYTHONUNBUFFERED=1

# ==============================================================================
# FRONTEND CONFIGURATION
# ==============================================================================
NEXT_PUBLIC_SPC_SSO_ISSUER=https://sso.spc.int
NEXT_PUBLIC_SPC_SSO_CLIENT_ID=ocean-portal

