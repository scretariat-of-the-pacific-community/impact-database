# Pacific Impact Database - Environment Configuration
# Copy this file to .env and modify the values as needed

# Database Configuration
POSTGRES_DB=impact_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@postgis_db:5432/impact_db

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# MinIO Configuration
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_USE_SSL=false
MINIO_BUCKET_NAME=impact-images

# Application Configuration
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=dev-secret-key-change-in-production
MAX_FILE_SIZE=52428800

# API Configuration
API_V1_STR=/api/v1
PROJECT_NAME=Pacific Impact Database
VERSION=1.0.0

# Security Configuration
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Configuration (comma-separated)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# File Upload Configuration
ALLOWED_FILE_EXTENSIONS=.jpg,.jpeg,.png,.tiff,.tif,.gif

# Thumbnail Configuration
THUMBNAIL_SIZE=200,200
THUMBNAIL_QUALITY=85

# Python Configuration
PYTHONPATH=/app
PYTHONUNBUFFERED=1
