# Environment Configuration Template
# Copy this file to .env and fill in your actual values
# NEVER commit the actual .env file to version control

# =============================================================================
# CRITICAL SECURITY WARNING
# =============================================================================
# 1. Generate strong, random secrets for production
# 2. Use different secrets for each environment (dev/staging/prod)
# 3. Store production secrets in a secrets manager (AWS Secrets Manager, Azure Key Vault, etc.)
# 4. Rotate secrets regularly (every 90 days recommended)
#
# Generate strong secrets using:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#   openssl rand -base64 32
# =============================================================================

# Application Environment
ENVIRONMENT=development  # Options: development, staging, production

# =============================================================================
# SECURITY - JWT & Authentication
# =============================================================================
# CRITICAL: Generate a strong, random secret key for production
# DO NOT use the example value below!
SECRET_KEY=GENERATE_STRONG_SECRET_HERE_USING_openssl_rand_base64_32

# JWT Configuration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION  # Use strong password!
POSTGRES_DB=impact_database
POSTGRES_HOST=postgis_db
POSTGRES_PORT=5432

# Database URL (constructed from above)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# Optional: Use password for Redis in production
# REDIS_PASSWORD=GENERATE_STRONG_PASSWORD_HERE

# =============================================================================
# OBJECT STORAGE (MinIO/S3)
# =============================================================================
# MinIO Configuration (local development)
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=GENERATE_STRONG_PASSWORD_HERE  # Change in production!
MINIO_BUCKET_NAME=impact-images
MINIO_USE_SSL=false  # Set to true in production with valid certificates

# AWS S3 Configuration (production alternative)
# AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY
# AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_KEY
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=your-production-bucket

# =============================================================================
# CORS & FRONTEND CONFIGURATION
# =============================================================================
# Allowed origins for CORS (comma-separated)
# Development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# Production (update with your actual domain)
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# PRODUCTION_DOMAIN=yourdomain.com

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# API Base URL (used by Celery workers for webhooks)
# Development: http://localhost:8000
# Production: https://api.yourdomain.com
API_BASE_URL=http://localhost:8000

# =============================================================================
# EMAIL CONFIGURATION (for notifications)
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=YOUR_APP_PASSWORD_HERE  # Use app-specific password, not account password
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=Impact Database

# =============================================================================
# OAUTH / SOCIAL AUTHENTICATION
# =============================================================================
# Google OAuth (for social login)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET_HERE
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Production Google OAuth
# GOOGLE_REDIRECT_URI=https://yourdomain.com/api/auth/google/callback

# =============================================================================
# MONITORING & OBSERVABILITY
# =============================================================================
# Sentry (error tracking)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Prometheus Metrics
ENABLE_METRICS=true
METRICS_PORT=9090

# =============================================================================
# CELERY (Background Tasks)
# =============================================================================
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
# API Configuration
API_V1_PREFIX=/api
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,webp

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# Logging
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_CORS=true
ENABLE_CSRF_PROTECTION=true
ENABLE_RATE_LIMITING=true
ENABLE_SECURITY_HEADERS=true

# =============================================================================
# DEVELOPMENT ONLY (Remove in production)
# =============================================================================
# Debug Mode
DEBUG=false  # MUST be false in production

# Reload on file changes (development only)
RELOAD=true

# =============================================================================
# PRODUCTION DEPLOYMENT SETTINGS
# =============================================================================
# Workers & Performance
# WORKERS=4  # Number of Gunicorn workers (2-4 × CPU cores)
# WORKER_CLASS=uvicorn.workers.UvicornWorker
# WORKER_TIMEOUT=120
# KEEPALIVE=5

# SSL/TLS
# SSL_KEYFILE=/path/to/keyfile.pem
# SSL_CERTFILE=/path/to/certfile.pem

# Backup Configuration
# BACKUP_ENABLED=true
# BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
# BACKUP_RETENTION_DAYS=30
# BACKUP_S3_BUCKET=your-backup-bucket

# =============================================================================
# NOTES
# =============================================================================
# 1. This is a TEMPLATE - copy to .env and customize
# 2. NEVER commit .env files to version control
# 3. Use environment-specific files (.env.development, .env.production)
# 4. Store production secrets in a secrets manager
# 5. Rotate all secrets regularly
# 6. Use strong, unique passwords for each service
# 7. Enable SSL/TLS in production
# 8. Review and update security settings before deployment
