DEBUG=False
SECRET_KEY=your-staging-secret-key
ALLOWED_HOSTS=staging.impactdb.org

# === Database (Cloud) ===
POSTGRES_DB=impactdb
POSTGRES_USER=staging_user
POSTGRES_PASSWORD=secure-staging-password
POSTGRES_HOST=staging-db.example.com
POSTGRES_PORT=5432

# === Microsoft Graph API ===
AZURE_TENANT_ID=your-staging-tenant-id
AZURE_CLIENT_ID=your-staging-client-id
AZURE_CLIENT_SECRET=your-staging-secret
GRAPH_API_SCOPES=https://graph.microsoft.com/.default

# === Email ===
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-org-staging-email@example.com
EMAIL_HOST_PASSWORD=staging-email-password

# === Storage (e.g. S3/MinIO) ===
DEFAULT_FILE_STORAGE=storages.backends.s3boto3.S3Boto3Storage
AWS_STORAGE_BUCKET_NAME=staging-impact-bucket
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret
AWS_S3_REGION_NAME=ap-southeast-2
