DEBUG=False
SECRET_KEY=prod-secret-key
ALLOWED_HOSTS=impactdb.org,www.impactdb.org

# === Database ===
POSTGRES_DB=impactdb
POSTGRES_USER=prod_user
POSTGRES_PASSWORD=super-secure-prod-password
POSTGRES_HOST=prod-db.cluster.region.rds.amazonaws.com
POSTGRES_PORT=5432

# === Microsoft Graph API ===
AZURE_TENANT_ID=your-prod-tenant-id
AZURE_CLIENT_ID=your-prod-client-id
AZURE_CLIENT_SECRET=your-prod-secret
GRAPH_API_SCOPES=https://graph.microsoft.com/.default

# === Email ===
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-org-email@example.com
EMAIL_HOST_PASSWORD=prod-email-password

# === Storage (e.g. S3) ===
DEFAULT_FILE_STORAGE=storages.backends.s3boto3.S3Boto3Storage
AWS_STORAGE_BUCKET_NAME=impact-database-prod-bucket
AWS_ACCESS_KEY_ID=your-prod-access-key
AWS_SECRET_ACCESS_KEY=your-prod-secret
AWS_S3_REGION_NAME=ap-southeast-2
