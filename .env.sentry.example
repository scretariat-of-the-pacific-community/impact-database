# Sentry Error Tracking Configuration
# Get your DSN from https://sentry.io (free tier available)

# Frontend Sentry DSN (public)
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Backend Sentry DSN (private, never expose)
SENTRY_DSN_API=https://examplePrivateKey@o0.ingest.sentry.io/0

# Environment
ENVIRONMENT=production

# Optional: Enable error tracking in development
SENTRY_DEBUG=false

# Optional: Session replay rate (0.0 to 1.0)
SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.1

# Optional: On-error replay rate (0.0 to 1.0)
SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1.0
