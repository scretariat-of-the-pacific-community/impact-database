# Production Environment Configuration Template
# Copy this file to .env and fill in the values with your secure credentials

# =============================================================================
# ENVIRONMENT
# =============================================================================
ENVIRONMENT=production
DEBUG=false

# =============================================================================
# APPLICATION SECURITY
# =============================================================================
# Generate a secure secret key (min 32 characters):
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_ME_TO_SECURE_RANDOM_STRING_MIN_32_CHARS

# API Documentation (disable in production for security)
ENABLE_API_DOCS=false

# JWT Configuration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# DATABASE (PostgreSQL with PostGIS)
# =============================================================================
POSTGRES_HOST=postgis_db
POSTGRES_PORT=5432
POSTGRES_DB=impact_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD

# Database URL with SSL
DATABASE_URL=postgresql://postgres:CHANGE_ME_TO_SECURE_PASSWORD@postgis_db:5432/impact_db?sslmode=require
DATABASE_SSL_MODE=require

# Connection Pool Settings
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# =============================================================================
# REDIS (Caching & Task Queue)
# =============================================================================
# Use rediss:// for SSL connection
REDIS_URL=rediss://redis:6379/0
REDIS_SSL=true
REDIS_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD

# =============================================================================
# MINIO (Object Storage)
# =============================================================================
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=CHANGE_ME_TO_SECURE_ACCESS_KEY
MINIO_ROOT_PASSWORD=CHANGE_ME_TO_SECURE_SECRET_KEY_MIN_8_CHARS
MINIO_ACCESS_KEY=CHANGE_ME_TO_SECURE_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_TO_SECURE_SECRET_KEY_MIN_8_CHARS
MINIO_BUCKET_NAME=impact-images
MINIO_REGION=us-east-1

# Enable HTTPS for MinIO
MINIO_SECURE=true
MINIO_USE_SSL=true

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW=900

# =============================================================================
# FILE UPLOAD
# =============================================================================
MAX_FILE_SIZE=52428800
ALLOWED_FILE_EXTENSIONS=jpg,jpeg,png,gif,bmp,tiff,webp,heic,heif
UPLOAD_DUPLICATE_POLICY=review
SCAN_UPLOADS=false

# =============================================================================
# CORS
# =============================================================================
# Comma-separated list of allowed origins (NO WILDCARDS in production)
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
ENABLE_CORS=true

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
EMAIL_BACKEND=smtp
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
EMAIL_FROM_NAME=Ocean Portal

# SMTP Settings (if using EMAIL_BACKEND=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_USE_TLS=true

# SendGrid Settings (if using EMAIL_BACKEND=sendgrid)
# SENDGRID_API_KEY=your-sendgrid-api-key

# Microsoft Graph Settings (if using EMAIL_BACKEND=msgraph)
# MSGRAPH_TENANT_ID=your-tenant-id
# MSGRAPH_CLIENT_ID=your-client-id
# MSGRAPH_CLIENT_SECRET=your-client-secret

# =============================================================================
# MONITORING & LOGGING
# =============================================================================
AUDIT_LOG_LEVEL=INFO
LOG_FAILED_LOGINS=true
LOG_RATE_LIMIT_VIOLATIONS=true
LOG_SECURITY_EVENTS=true

# Sentry (Optional - for error tracking)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# SENTRY_TRACES_SAMPLE_RATE=0.05
# SENTRY_ENABLE_TRACING=true

# =============================================================================
# SESSION SECURITY
# =============================================================================
SESSION_SECURE=true
SESSION_SAMESITE=strict
SESSION_HTTPONLY=true

# =============================================================================
# CONTENT SECURITY POLICY
# =============================================================================
CSP_DEFAULT_SRC='self'
CSP_SCRIPT_SRC='self' 'unsafe-inline'

# =============================================================================
# EXIF/METADATA EXTRACTION
# =============================================================================
EXIF_LIBRARY=PIL
ENABLE_XMP_EXTRACTION=false
AUTO_CONVERT_HEIF=true
HEIF_JPEG_QUALITY=95

# =============================================================================
# THUMBNAIL GENERATION
# =============================================================================
THUMBNAIL_QUALITY=85

# =============================================================================
# PYTHON CONFIGURATION
# =============================================================================
PYTHONPATH=/app
PYTHONUNBUFFERED=1

# =============================================================================
# STARTUP RESILIENCE
# =============================================================================
MAX_DB_RETRIES=60

# =============================================================================
# SECURITY CHECKLIST
# =============================================================================
# Before deploying to production, ensure you have:
# ✓ Changed all CHANGE_ME passwords to secure random values
# ✓ Generated a strong SECRET_KEY (min 32 chars)
# ✓ Set ENVIRONMENT=production
# ✓ Set DEBUG=false
# ✓ Set ENABLE_API_DOCS=false
# ✓ Enabled SSL for all services (MINIO_SECURE, REDIS_SSL, DATABASE_SSL_MODE)
# ✓ Generated SSL certificates (run ./setup_ssl.sh)
# ✓ Configured proper CORS origins (no wildcards)
# ✓ Set up proper DNS and domain names
# ✓ Configured firewall rules
# ✓ Set up backup procedures
# ✓ Configured monitoring/alerting (optional but recommended)
